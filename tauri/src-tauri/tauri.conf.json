{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YubiKey Encrypter",
  "version": "1.0.0",
  "identifier": "com.evlbon.yk-encrypter",
  "mainBinaryName": "yk-encrypter",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "npm run build:ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "YubiKey Encrypter",
        "width": 640,
        "height": 620,
        "minWidth": 540,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
